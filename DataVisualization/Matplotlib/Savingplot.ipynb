   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "fig = plt.figure()\n",
    "ax=fig.add_axes([0.1,0.1,0.8,0.8])\n",
    "x = np.linspace(0,5,11)\n",
    "y = x**2\n",
    "ax.plot(x,y)\n",
    "plt.savefig(\"basicplot.png\")\n",
    "\n"
   ]
