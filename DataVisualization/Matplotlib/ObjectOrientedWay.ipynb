    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "x = np.linspace(0,5,11)\n",
    "y = x**2\n",
    "fig = plt.figure(figsize=(6,8))\n",
    "axis1=fig.add_axes([0.1,0.1,0.6,0.8])\n",
    "axis1.plot(x,y)\n",
    "axis2=fig.add_axes([0.3,0.1,0.6,0.1])\n",
    "axis2.plot(x,y)\n"
   ]
