   "source": [
    "#Subplots in Matplotlib\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "x = np.linspace(0,5,11)\n",
    "y = x**2\n",
    "plt.subplot(2,2,1)\n",
    "plt.subplot(2,2,4)\n",
    "plt.plot(x,y)\n",
    "plt.subplot(2,2,2)\n",
    "plt.subplot(2,2,3)\n",
    "plt.subplot(2,2,1)\n",
    "plt.plot(x**2,x**2)\n",
    "\n"
   ]
